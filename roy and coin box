#include<bits/stdc++.h>
using namespace std;
int main(){
    int n;
    int m;
    cin>>n>>m;
    vector<int> vec(n+1,0);
    for(int i=0;i<m;i++){
        int l;
        cin>>l;
        vec[l]++;
        int r;
        cin>>r;
        if(r<n) vec[r+1]--;
    }
    int update = 0;
    vector<int> vec2(m+2,0); 
    for(int i=1;i<=n;i++){
        update += vec[i];
        vec[i] = update;
        if(vec[i]) vec2[vec[i]]++;
    }
    for(int i=m;i>=0;i--){
        vec2[i] += vec2[i+1];
    }
    int q;
    cin>>q;
    for(int i=0;i<q;i++){
        int x;
        cin>>x;
        if (x<=m)cout<<vec2[x]<<"\n";
        else cout<<0<<"\n";
    }
}
