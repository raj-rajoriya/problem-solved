#include<bits/stdc++.h>
#define inf INT_MAX
using namespace std;
int fun(int a,vector<int> &dp){
    if(a == 1) return 0;
    if(a == 2) return 1;
    if(a == 3) return 1;
    if(dp[a] != -1) return dp[a];
    return 1+min(fun(a-1,dp),min((a%2==0) ? fun(a/2,dp):inf,(a%3==0) ? fun(a/3,dp):inf));
}
int main(){
    int n;
    cin>>n;
    vector<int> dp(n+1,-1);
    cout<<fun(n,dp)<<endl;
}}
