#include<bits/stdc++.h>
#define inf INT_MAX
using namespace std;
int main(){
    int n;
    cin>>n;
    vector<int> min_steps(n+1);
    min_steps[1] = 0;
    min_steps[2] = 1;
    min_steps[3] = 1;
    for(int i=4;i<=n;i++){
        min_steps[i] = 1 + min(min_steps[i-1],min((i%2==0) ? min_steps[i/2]:inf,(i%3==0) ? min_steps[i/3]:inf));
    }
    cout<<min_steps[n];
}
