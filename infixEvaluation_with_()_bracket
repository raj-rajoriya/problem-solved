#include<bits/stdc++.h>
using namespace std;
int prio(char ch){
    if(ch == '+' || ch == '-') return 1;
    else if(ch == '*' || ch == '/') return 2;
    else if(ch == '(') return 0;
    return 0;
}
int opr(int val1,int val2,char ch){
     if(ch=='+') return val1+val2;   
     else if(ch=='-') return val1-val2;   
     else if(ch=='*') return val1*val2;   
     else if(ch=='/') return val1/val2;
     return 0;  
}
int main(){
    string str;
    cout<<"Enter the string : ";
    cin>>str;
    int len = str.size();
    stack<int> val;
    stack<char> op;
    for(int i=0;i<len;i++){
        if(str[i]>=48 && str[i]<=57) val.push(str[i]-48);
        else if(str[i]=='(') op.push('(');
        else if(str[i]==')'){
            while(op.top() != '('){
                char ch = op.top();
                op.pop();
                int val2 = val.top();
                val.pop(); 
                int val1 = val.top(); 
                val.pop();
                val.push(opr(val1,val2,ch));
            }
            op.pop();
        }
        else if(op.size()==0 || prio(str[i])>prio(op.top())){
            op.push(str[i]);
        }
        else{
            while(op.size()>0 && prio(str[i])<=prio(op.top())){
                char ch = op.top();
                op.pop();
                int val2 = val.top();
                val.pop(); 
                int val1 = val.top(); 
                val.pop();
                val.push(opr(val1,val2,ch));
            }
            op.push(str[i]);
        }
    }
    while(op.size()>0){
        char ch = op.top();
        op.pop();
        int val2 = val.top();
        val.pop(); 
        int val1 = val.top(); 
        val.pop();
        val.push(opr(val1,val2,ch));
    }
    cout<<val.top()<<endl;
}
