#include<bits/stdc++.h>
#define mod 1000000007
using namespace std;
int main(){
    int n;
    cin>>n;
    vector<int> vec(n+1,0);
    vec[1] = 1;
    if(n>=2)vec[2] = 1;
    if(n>=3)vec[3] = 1;
    if(n>=4)vec[4] = 1;
    if(n>=5)vec[5] = 1;
    if(n>=6)vec[6] = 1;
    for(int i=1;i<=n;i++){
        for(int j=1;j<7;j++){
            if(i+j > n) break;
            vec[i+j] = (vec[i+j]%mod+vec[i]%mod)%mod;
        }
    }
    cout<<vec[n]%mod<<endl;
}
