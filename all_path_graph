#include<bits/stdc++.h>
using namespace std;
vector<list<int>> graph;
vector<vector<int>> ans;
unordered_set<int> check;
vector<int> path;
bool flag;
int destination;
void fun(int strt){
    if(check.count(strt)) return;
    path.push_back(strt);
    check.insert(strt);
    if(strt == destination) ans.push_back(path);
    else{
        for(auto ele : graph[strt]){
            fun(ele);
        }
    }
    path.pop_back();
    check.erase(strt);
    return;
}
void add_edges(int src,int des,bool bi_direc = true){
    graph[src].push_back(des);
    if(bi_direc) graph[des].push_back(src);    
    return;
}
int main(){
    int v,e;
    cout<<"Enter the vertices and edges : ";
    cin>>v>>e;
    graph.resize(v,list<int> ());
    int src,des;
    vector<bool> check(v,true);
    while(e--){
        cout<<"Enter the source and destination : ";
        cin>>src>>des;
        add_edges(src,des);
    }
    fun(6);
    int size = ans.size();
    for(int i=0;i<size;i++){
        for(auto ele : ans[i]){
            cout<<ele<<" ";
        }
        cout<<endl;
    }
}
