#include<bits/stdc++.h>
using namespace std;
int solve(char ch,int val1,int val2){
    if(ch=='+') return val1+val2; 
    if(ch=='-') return val1-val2; 
    if(ch=='*') return val1*val2; 
    if(ch=='/') return val1/val2; 
}
int main(){
    string str;
    cout<<"Enter the postfix order: ";
    cin>>str;
    stack<int> val;
    stack<char> op;
    for(int i=0;i<str.size();i++){
        if(str[i]>=48 && str[i]<=57) val.push(str[i]-48);
        else{
            char ch = str[i];
            int val2 = val.top();
            val.pop();
            int val1= val.top();
            val.pop();
            val.push(solve(ch,val1,val2));
        }
    }
    cout<<val.top()<<endl;
 }
