#include<bits/stdc++.h>
using namespace std;
int main(){
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    int a;
    cin>>a;
    vector<int> vec;
    while(a--){
        int x;
        cin>>x;
        vec.push_back(x);
    }
    vector<vector<pair<int,int>>> dp(vec.size(),vector<pair<int,int>> (vec.size(),{0,0}));
    for(int i=0;i<vec.size();i++){
        dp[i][i] = {0,vec[i]};
    }
    for(int i=2;i<=vec.size();i++){
        for(int j=0;j+i-1<vec.size();j++){
            int k = j+i-1;
            dp[j][k] = {INT_MAX,INT_MAX};
            for(int z=j;z<k;z++){
                int c = dp[j][z].first+dp[z+1][k].first+dp[j][z].second*dp[z+1][k].second;
                if(dp[j][k].first > c){
                    dp[j][k] = {c,(dp[j][z].second+dp[z+1][k].second)%100};
                }
            }
        }
    }
    cout<<dp[0][vec.size()-1].first<<endl;
}
