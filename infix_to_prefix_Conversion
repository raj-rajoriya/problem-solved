#include<bits/stdc++.h>
using namespace std;
int prio(char ch){
    if(ch == '+' || ch == '-') return 1;
    else if(ch == '*' || ch == '/') return 2;
    return 0;
}
int main(){
    string str;
    cout<<"Enter the string : ";
    cin>>str;
    int len = str.size();
    stack<char> op;
    stack<string> val;
    for(int i=0;i<len;i++){
        if(str[i]>=48 && str[i]<=57) val.push(string(1,str[i]));
        else if(op.size()==0 || prio(str[i]) > prio(op.top())) op.push(str[i]);
        else {
            while(op.size()>0 && prio(str[i])<=prio(op.top())){
                char ch = op.top();
                op.pop();
                string val2 = val.top();
                val.pop();
                string val1 = val.top();
                val.pop();
                val.push(string(1,ch)+val1+val2);
            }
            op.push(str[i]);
        }
    } 
    while(op.size()>0){
        char ch = op.top();
        op.pop();
        string val2 = val.top();
        val.pop();
        string val1 = val.top();
        val.pop();
        val.push(ch+(string)val1+(string)val2);
    }
    cout<<val.top()<<endl;
}
