#include<bits/stdc++.h>
using namespace std;
int main(){
    int t;
    cin>>t;
    while(t--){
        int m,n;
        cin>>n>>m;
            int n1 = n-1;
            int m1 = m-1;
            int b1,b2;
            int v1,v2;
            cin>>b2;
            int ber=0,ver=0;
            if(n==1) ber = b2;
            else{
                while(n1--){
                    b1=b2;
                    cin>>b2;
                    if(n1==0) ber += (b1-b2+1+b2);
                    else ber += (b1-b2+1);
                }
            }
            cin>>v2;
            if(m == 1) ver = v2;
            else{
                while(m1--){
                    v1=v2;
                    cin>>v2;
                    if(m1==0) ver += (v1-v2+1+v2);
                    else ver += (v1-v2+1);
                }
            }
            if(ber >= ver) cout<<1<<endl;
            else cout<<2<<endl;
        
    }
}
