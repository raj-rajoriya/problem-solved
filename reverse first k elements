#include<bits/stdc++.h>
using namespace std;
int main(){
    queue<int> q;
    stack<int> st;
    int k;
    for(int i=0;i<k;i++){
        st.push(q.front());
        q.pop();
    }
    for(int i=0;i<k;i++){
        q.push(st.top());
        st.pop();
    }
    for(int i=0;i<q.size()-k;i++){
        q.push(q.front());
        q.pop();
    }
    while(q.size()){
        cout<<q.front()<<" ";
        q.pop();
    }
}
