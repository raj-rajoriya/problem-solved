#include<bits/stdc++.h>
using namespace std;
bool fun(vector<char> &flag,string &s){
    int z = s.size();
    for(int i=0;i<z;i++){
        char c = s[i];
        if(flag[c-65]==0) return false;
    }
    return true;
}
int main(){
    int t;
    cin>>t;
    while(t--){
        int m,n;
        cin>>n>>m;
        int n1 = n;
        int m1 = m;
        vector<char> flag(26,0);
        vector<string> abbreviation;
        string str;
        char str2;
        string checker = "YES";
        while(n1--){
            cin>>str;
            str2 = str[0];
            flag[str2-97] = 1;
        }
        while(m1--){
            cin>>str;
            abbreviation.push_back(str);
        }
        for(int i=0;i<m;i++){
            if(!fun(flag,abbreviation[i])){
                checker = "NO";
                break;
            }
        }
        cout<<checker<<endl;
    }
}
