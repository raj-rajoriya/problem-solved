#include<bits/stdc++.h>
using namespace std;
int main(){
    int k,l,m;
    cin>>k>>l>>m;
    vector<int> val(m);
    int maxm = INT_MIN;
    for(int i=0;i<m;i++){
        cin>>val[i];
        maxm = max(maxm,val[i]);
    }
    vector<char>vec(1000005,'L');
    vec[0] = 'L';
    vec[1] = 'W';
    vec[k] = 'W';
    vec[l] = 'W';
    for(int j=2;j<=maxm;j++){
        if(j == k || j == l) continue;
        else if(j-1>=0 && vec[j-1]=='L') vec[j] = 'W';
        else if(j-l>=0 && vec[j-l]=='L')  vec[j] = 'W';
        else if(j-k>=0 && vec[j-k]=='L') vec[j] ='W';
        else vec[j]='L';
    }
    string str = "";
    for(int i=0;i<m;i++){
        if(vec[val[i]] == 'W') str += "A";
        else str += "B";
    }
    cout<<str<<endl;
}
